# Copy to .env (auto-loaded if python-dotenv is installed) or export in your shell.

# --- required ---
ANTHROPIC_API_KEY=sk-ant-...

# --- backend switch: "api" (Anthropic API SDK) or "agent" (Claude Agent SDK) ---
LLM_BACKEND=api

# --- shared config ---
ANTHROPIC_MODEL=claude-haiku-4-5
SYSTEM_PROMPT=You are a concise assistant. Answer in one or two sentences.
MAX_TOKENS=1024

# --- agent-backend only ---
AGENT_ALLOWED_TOOLS=Read,Glob,Grep
AGENT_MAX_TURNS=3
